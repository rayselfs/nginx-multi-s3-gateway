# This configuration should dynamically reload S3 backends
# as they change in DNS.

# Use NGINX's non-blocking DNS resolution
resolver ${DNS_RESOLVERS};

# Default upstream – used when no X-S3-Bucket header is present or the value
# is not in the whitelist. Built from S3_UPSTREAM which is derived from
# S3_BUCKET_NAME / S3_SERVER at container start by the entrypoint script.
upstream storage_urls {
    zone s3_backends 64k;

    server ${S3_UPSTREAM} resolve;
    keepalive 32;
}

# ---------------------------------------------------------------------------
# Per-bucket upstreams for S3_STYLE=virtual-v2.
#
# For virtual-v2 each bucket needs its own upstream because the TCP connection
# target differs per bucket (bucket-name.s3.amazonaws.com). For virtual/path
# style the storage_urls upstream above is sufficient.
#
# This file is rendered by Helm and mounted as a ConfigMap at:
#   /etc/nginx/conf.d/gateway/per-bucket-upstreams.conf
# It is empty when S3_STYLE != virtual-v2 or no extra buckets are defined.
# ---------------------------------------------------------------------------
include /etc/nginx/conf.d/gateway/per-bucket-upstreams.conf;
