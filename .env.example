# ─── AWS / S3 ─────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=my-default-bucket
S3_REGION=ap-northeast-1
S3_SERVER=s3.amazonaws.com
S3_SERVER_PORT=443
S3_SERVER_PROTO=https
# S3_STYLE options: virtual (default), virtual-v2, path
S3_STYLE=virtual
AWS_SIGS_VERSION=4

# ─── AWS Credentials ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # required for temporary credentials (IAM role, IRSA, etc.)

# ─── Dynamic Bucket Routing ───────────────────────────────────────────────────
# Send X-S3-Bucket: <bucket-name> in your request to route to a specific bucket.
# Only bucket names listed in the whitelist maps (default.conf.template) are
# accepted. Unlisted values are silently ignored → falls back to S3_BUCKET_NAME.
#
# To add a bucket:
#   1. Uncomment / add a line in all three map blocks in:
#        common/etc/nginx/templates/default.conf.template
#   2. For S3_STYLE=virtual-v2: also add a named upstream in:
#        oss/etc/nginx/templates/upstreams.conf.template
#   3. Rebuild the image: docker build -t my-nginx-s3-gateway .

# ─── Caching ──────────────────────────────────────────────────────────────────
PROXY_CACHE_VALID_OK=1h
PROXY_CACHE_VALID_NOTFOUND=1m
PROXY_CACHE_VALID_FORBIDDEN=30s
PROXY_CACHE_USE_STALE=error timeout updating http_500 http_502 http_503 http_504
PROXY_CACHE_SLICE_SIZE=1m

# ─── Other ────────────────────────────────────────────────────────────────────
DNS_RESOLVERS=8.8.8.8 ipv6=off
ALLOW_DIRECTORY_LIST=false
PROVIDE_INDEX_PAGE=false
APPEND_SLASH_FOR_POSSIBLE_DIRECTORY=false
FOUR_O_FOUR_ON_EMPTY_BUCKET=false
STRIP_LEADING_DIRECTORY_PATH=
PREFIX_LEADING_DIRECTORY_PATH=
DIRECTORY_LISTING_PATH_PREFIX=
CORS_ENABLED=false
LIMIT_METHODS_TO=GET HEAD
LIMIT_METHODS_TO_CSV=GET, HEAD
