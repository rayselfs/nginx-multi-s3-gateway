# Core S3 settings
S3_SERVER=s3.amazonaws.com
S3_SERVER_PORT=443
S3_SERVER_PROTO=https
S3_REGION=us-east-1
S3_STYLE=virtual
S3_BUCKET_NAME=my-default-bucket

# AWS credentials (omit / leave blank when using IRSA on EKS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional features
CORS_ENABLED=0
ALLOW_DIRECTORY_LIST=0
# STRIP_LEADING_DIRECTORY_PATH=
# PREFIX_LEADING_DIRECTORY_PATH=
# DIRECTORY_LISTING_PATH_PREFIX=

# DNS resolver for NGINX upstream resolve directive.
# Leave blank to let the upstream entrypoint auto-detect from /etc/resolv.conf.
# Example for EKS: DNS_RESOLVERS=172.20.0.10 valid=5s ipv6=off
# DNS_RESOLVERS=
